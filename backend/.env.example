# ============================================================
# Environment Configuration — COPY TO .env AND FILL IN VALUES
# Module 4: Secrets managed via environment variables, never hardcoded
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# JWT Secret — use a long, random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-characters
JWT_EXPIRES_IN=24h

# Database (SQLite file path)
DATABASE_URL=file:./dev.db

# File upload settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_PAGE_COUNT=200

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Admin setup token (used for initial admin user creation)
ADMIN_SETUP_TOKEN=change-this-admin-setup-token
